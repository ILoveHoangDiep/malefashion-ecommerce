{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/payment-process-payment.json",
  "title": "payment.process-payment (command)",
  "description": "order-service gửi tới payment-service. mockScenario chỉ dùng ở profile demo/local; production bỏ field.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "payment.process-payment"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "amount",
        "idempotencyKey"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "description": "Hiện dùng chính orderId."
        },
        "mockScenario": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "FAILURE",
            "TIMEOUT"
          ],
          "description": "Chỉ dùng ở profile demo/local."
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "d4c5b6a7-f8e9-4d0e-9f2a-3b4c5d6e7f8a",
      "eventType": "payment.process-payment",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:15:32.000Z",
      "producer": "order-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "amount": {
          "amount": "578000.00",
          "currency": "VND"
        },
        "idempotencyKey": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "mockScenario": "SUCCESS"
      }
    }
  ]
}
