{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/payment-succeeded.json",
  "title": "payment.succeeded",
  "description": "payment-service phát khi thanh toán mock thành công. Chỉ order-service nghe; notification không nghe payment.*.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "payment.succeeded"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "paymentId",
        "amount",
        "providerTransactionId",
        "paidAt"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "paymentId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "providerTransactionId": {
          "type": "string",
          "minLength": 1
        },
        "paidAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "8b9c0d1e-2f3a-4b4c-9d5e-6f7a8b9c0d1e",
      "eventType": "payment.succeeded",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:15:45.789Z",
      "producer": "payment-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "paymentId": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
        "amount": {
          "amount": "578000.00",
          "currency": "VND"
        },
        "providerTransactionId": "MOCK-TXN-20261022-000001",
        "paidAt": "2026-10-22T03:15:45.789Z"
      }
    }
