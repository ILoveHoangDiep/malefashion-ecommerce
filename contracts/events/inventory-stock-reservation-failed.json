{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/inventory-stock-reservation-failed.json",
  "title": "inventory.stock-reservation-failed",
  "description": "inventory-service phát khi không giữ được chỗ. order-service hủy đơn trực tiếp, không gửi inventory.release-stock.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "inventory.stock-reservation-failed"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reason",
        "failedItems",
        "failedAt"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "type": "string",
          "enum": [
            "INSUFFICIENT_STOCK",
            "VARIANT_NOT_FOUND",
            "CONCURRENT_MODIFICATION"
          ]
        },
        "failedItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/failedItem"
          }
        },
        "failedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "failedItem": {
      "type": "object",
      "required": [
        "variantId",
        "sku",
        "requestedQuantity",
        "availableQuantity"
      ],
      "additionalProperties": true,
      "properties": {
        "variantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "sku": {
          "$ref": "common.schema.json#/$defs/Sku"
        },
        "requestedQuantity": {
          "type": "integer",
          "minimum": 1
        },
        "availableQuantity": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
      "eventType": "inventory.stock-reservation-failed",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:15:31.456Z",
      "producer": "inventory-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "reason": "INSUFFICIENT_STOCK",
        "failedItems": [
          {
            "variantId": "52e1d8ae-7c8f-5ec8-9ce7-a4c81caed6f5",
            "sku": "MF-TEE-BLACK-M",
            "requestedQuantity": 2,
            "availableQuantity": 1
          }
        ],
        "failedAt": "2026-10-22T03:15:31.456Z"
      }
    }
  ]
}
