{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/payment-refunded.json",
  "title": "payment.refunded",
  "description": "payment-service phát khi hoàn tiền toàn đơn thành công. order-service sau đó phát order.cancelled với reason=STOCK_COMMIT_FAILED.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "payment.refunded"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "paymentId",
        "refundId",
        "amount",
        "refundedAt"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "paymentId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "refundId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "refundedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "0d1e2f3a-4b5c-4d6e-9f70-8b9c0d1e2f3a",
      "eventType": "payment.refunded",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:18:00.000Z",
      "producer": "payment-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "paymentId": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
        "refundId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
        "amount": {
          "amount": "578000.00",
          "currency": "VND"
        },
        "refundedAt": "2026-10-22T03:18:00.000Z"
      }
    }
  ]
}
