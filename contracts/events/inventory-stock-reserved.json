{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/inventory-stock-reserved.json",
  "title": "inventory.stock-reserved",
  "description": "inventory-service phát khi giữ chỗ tồn kho thành công. expiresAt = thời điểm reservation hết TTL (15 phút).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "inventory.stock-reserved"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reservationId",
        "expiresAt",
        "items"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "reservationId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "variantId",
        "sku",
        "quantity"
      ],
      "additionalProperties": true,
      "properties": {
        "variantId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "sku": {
          "$ref": "common.schema.json#/$defs/Sku"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f",
      "eventType": "inventory.stock-reserved",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:15:31.000Z",
      "producer": "inventory-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "reservationId": "7a8b9c0d-1e2f-4a3b-9c4d-5e6f7a8b9c0d",
        "expiresAt": "2026-10-22T03:30:30.123Z",
        "items": [
          {
            "variantId": "52e1d8ae-7c8f-5ec8-9ce7-a4c81caed6f5",
            "sku": "MF-TEE-BLACK-M",
            "quantity": 2
          }
        ]
      }
    }
  ]
}
