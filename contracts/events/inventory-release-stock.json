{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://malefashion.local/contracts/events/inventory-release-stock.json",
  "title": "inventory.release-stock (command)",
  "description": "order-service gửi tới inventory-service khi payment thất bại hoặc saga timeout. Không gửi khi reservation-failed.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "eventType",
        "payload"
      ],
      "properties": {
        "eventType": {
          "const": "inventory.release-stock"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reservationId",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "orderId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "reservationId": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "reason": {
          "type": "string",
          "enum": [
            "PAYMENT_FAILED",
            "SAGA_TIMEOUT"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "c3b4a5f6-e7d8-4c9d-8e1f-2a3b4c5d6e7f",
      "eventType": "inventory.release-stock",
      "eventVersion": 1,
      "occurredAt": "2026-10-22T03:16:30.000Z",
      "producer": "order-service",
      "correlationId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "payload": {
        "orderId": "5d1c9b2a-8e4f-4a6b-b1c2-3d4e5f6a7b8c",
        "reservationId": "7a8b9c0d-1e2f-4a3b-9c4d-5e6f7a8b9c0d",
        "reason": "PAYMENT_FAILED"
      }
    }
  ]
}
